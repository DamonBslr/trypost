# TryPost — production / Coolify environment template.
# Copy to `.env` next to compose.prod.yaml, or paste into Coolify →
# Environment Variables (Developer view). Compose interpolates these
# into compose.prod.yaml; do not commit the filled-in file.

# ===== Required =====
APP_NAME=TryPost
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000
SELF_HOSTED=true

# Host port for the app when not using Coolify's proxy. Coolify ignores this
# and routes via the domain assigned to the `app` service.
APP_PORT=8000

# ===== Database (must match the bundled `pgsql` service, or your own) =====
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=trypost
DB_USERNAME=trypost
DB_PASSWORD=

# ===== Redis / queue / cache / broadcasting =====
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
BROADCAST_CONNECTION=reverb

# ===== WebSockets (Reverb) =====
REVERB_APP_ID=1001
REVERB_APP_KEY=trypost-reverb-key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ===== Passport (OAuth / API keys / MCP) =====
# Generate with (Passport has no --show; it writes storage/oauth-*.key):
#   docker run --rm -e APP_URL=http://localhost ghcr.io/trypostit/trypost:latest \
#     sh -c 'php artisan passport:keys --force && cat storage/oauth-private.key && echo && cat storage/oauth-public.key'
# Coolify: enable Multiline on both, or paste as one line with literal \n.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# ===== Storage =====
FILESYSTEM_DISK=public

# Cloudflare R2 (set FILESYSTEM_DISK=r2)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_BUCKET=
# R2_URL=

# AWS S3 (set FILESYSTEM_DISK=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=

# ===== Mail =====
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=TryPost
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls

# ===== Social platforms =====
# Redirect URI in each portal: ${APP_URL}/accounts/<platform>/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# THREADS_CLIENT_ID=
# THREADS_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# PINTEREST_CLIENT_ID=
# PINTEREST_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ===== AI (optional) =====
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ELEVENLABS_API_KEY=

# ===== Optional Caddy proxy (compose --profile proxy) =====
# APP_DOMAIN=post.example.com
